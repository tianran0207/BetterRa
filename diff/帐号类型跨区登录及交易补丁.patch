Index: conf/import/battle_conf.txt
===================================================================
--- conf/import/battle_conf.txt	(版本 2357)
+++ conf/import/battle_conf.txt	(工作副本)
@@ -0,0 +1,22 @@
+//===========================================================================
+// 不同帐号类型(跨区)的玩家是否允许相互交易?
+// 帐号类型为数据库 login 表内的 server 类型
+// 设置 0 为无视是否跨区帐号(全区交易)
+// 设置 1 为仅仅 server 类型 1 的帐号可交易
+//===========================================================================
+map_server_filter: 0
+
+//===========================================================================
+// 当 map_server_filter 不为 0 时, 可交易权限
+// 数值参考为 item_trade.txt 的交易权限
+// 1   - 无法丢弃
+// 2   - 无法交易 (无法公开)
+// 4   - 已婚的人可无视限制2
+// 8   - 不能被卖出给NPC
+// 16  - 不能被放入手推车中
+// 32  - 不能被放入仓库中
+// 64  - 不能被放入公会仓库中
+// 128 - 不能被附加到邮件
+// 256 - 不能被拍卖
+//===========================================================================
+server_item_trade: 0
